# Local Docker defaults (optional). Copy: cp deploy/.env.example deploy/.env
WEB_PORT=8080
API_PORT=8787
WEB_ORIGIN=http://127.0.0.1:8080
# Leave empty so the web container uses nginx → api:8787 same-origin
VITE_API_BASE=
COOKIE_SECURE=0
WORKSPACE_ROOT=./workspaces

# Optional
# LOGIN_DISABLED=true (no login gate)
# ALLOW_NETWORK_ACCESS=true (allow local network access)
# 
# GitHub OAuth (optional). Local compose does NOT load .env.server — put values here.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Register this callback on the GitHub OAuth App for local Docker:
# GITHUB_REDIRECT_URI=http://127.0.0.1:8080/api/auth/github/callback
