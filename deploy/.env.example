# Local Docker defaults (optional). Copy: cp deploy/.env.example deploy/.env
WEB_PORT=8080
API_PORT=8787
# Optional hint for device-pair URLs when no HTTP request context.
# Cookies / CORS / OAuth redirect are derived from Host + X-Forwarded-Proto at runtime.
WEB_ORIGIN=http://127.0.0.1:8080
# Leave empty so the web container uses nginx → api:8787 same-origin
VITE_API_BASE=

# GitHub OAuth (optional for local)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Optional pin; if unset, derived as {request origin}/api/auth/github/callback
# GITHUB_REDIRECT_URI=http://127.0.0.1:8080/api/auth/github/callback
