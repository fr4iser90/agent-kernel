# Optional — compose.server.yml on a host that ALREADY runs Traefik.
# Copy to deploy/.env.server (gitignored) and fill real values — NEVER commit secrets.
#
#   cp deploy/.env.server.example deploy/.env.server
#   docker compose -f deploy/compose.yml -f deploy/compose.server.yml \
#     --env-file deploy/.env --env-file deploy/.env.server up -d --build

WEB_HOST=agent-kernel.fr4iser.com
API_HOST=api.agent-kernel.fr4iser.com
WEB_ORIGIN=https://agent-kernel.fr4iser.com
VITE_API_BASE=https://api.agent-kernel.fr4iser.com

TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
CERT_RESOLVER=http_resolver
# Optional Traefik middleware (app has its own login). Example: default@file
# AUTH_MIDDLEWARE=

WORKSPACE_ROOT=/home/docker/docker/agent-kernel/workspaces

# GitHub OAuth App — put real values only in deploy/.env.server (not here)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://api.agent-kernel.fr4iser.com/api/auth/github/callback
COOKIE_SECURE=1

# Optional deploy default — users also set SSH target in Setup (My Executor).
# EXECUTOR_SSH_TUNNEL_TARGET=docker@your-server
EXECUTOR_SSH_TUNNEL_ENDPOINT_HOST=host.docker.internal
EXECUTOR_SSH_TUNNEL_PORT_BASE=13100

# DATABASE_URL=
# POSTGRES_USER=agent
# POSTGRES_PASSWORD=agent
# POSTGRES_DB=agent_kernel
