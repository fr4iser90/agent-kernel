# Server secrets for compose.server.yml (Traefik labels). Gitignored.
# Runtime cookies/CORS/OAuth redirect derive from Host + X-Forwarded-Proto — no COOKIE_SECURE needed.
#
#   cp deploy/.env.server.example deploy/.env.server
#   docker compose -f deploy/compose.yml -f deploy/compose.server.yml \
#     --env-file deploy/.env.server up -d --build

# Traefik Host() rules only (not used for cookie Secure)
WEB_HOST=kernel.example.com
API_HOST=api.kernel.example.com
# Device-pair public URL (DSH has no browser Host header)
WEB_ORIGIN=https://kernel.example.com
VITE_API_BASE=

TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
CERT_RESOLVER=http_resolver

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional pin; if unset, derived from the browser Host on /api/auth/github
GITHUB_REDIRECT_URI=https://kernel.example.com/api/auth/github/callback

# DATABASE_URL=
# POSTGRES_USER=agent
# POSTGRES_PASSWORD=agent
# POSTGRES_DB=agent_kernel
