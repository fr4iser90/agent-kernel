# Optional — compose.server.yml on a host that ALREADY runs Traefik.
# Copy to deploy/.env.server (gitignored) and fill real values — NEVER commit secrets.
#
#   cp deploy/.env.server.example deploy/.env.server
#   docker compose -f deploy/compose.yml -f deploy/compose.server.yml \
#     --env-file deploy/.env --env-file deploy/.env.server up -d --build

WEB_HOST=kernel.example.com
API_HOST=api.kernel.example.com
WEB_ORIGIN=https://kernel.example.com
# Leave empty so the browser talks same-origin /api (web nginx → api). Required for cookies.
VITE_API_BASE=

TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
CERT_RESOLVER=http_resolver
# Optional Traefik middleware (app has its own login). Example: default@file
# AUTH_MIDDLEWARE=

WORKSPACE_ROOT=/var/lib/agent-kernel/workspaces

# GitHub OAuth App — put real values only in deploy/.env.server (not here)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://kernel.example.com/api/auth/github/callback
COOKIE_SECURE=1

# DATABASE_URL=
# POSTGRES_USER=agent
# POSTGRES_PASSWORD=agent
# POSTGRES_DB=agent_kernel
