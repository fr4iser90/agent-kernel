# syntax=docker/dockerfile:1
# API image: pnpm/tsx are resolved at *build* time. Runtime must not call
# registry.npmjs.org (Corepack prepare) — hosts often block outbound npm.

FROM node:22-bookworm-slim AS deps
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/api/package.json apps/api/
COPY packages packages
RUN pnpm install --frozen-lockfile --filter @agent-kernel/api...

FROM deps AS build
COPY apps/api apps/api
COPY lawpack lawpack
COPY scripts scripts
RUN pnpm --filter @agent-kernel/api run build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV AK_REPO_ROOT=/app
RUN apt-get update && apt-get install -y --no-install-recommends wget \
  && rm -rf /var/lib/apt/lists/*
# Install tree from build (includes pnpm store + tsx). No corepack at runtime.
COPY --from=build /app /app
WORKDIR /app/apps/api
EXPOSE 8787
# tsx is a dependency of the workspace install; invoke via node (no pnpm/Corepack).
CMD ["node", "--import", "tsx", "src/presentation/main.ts"]
